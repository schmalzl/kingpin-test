# Copy to .env and edit. Never commit .env.
KINGPIN_ENV=development
# Leave empty to auto-generate and persist a key in instance/secret_key
KINGPIN_SECRET_KEY=
KINGPIN_DB_PATH=instance/kingpin.db
KINGPIN_ADMIN_USERNAME=admin_001
# One-time bootstrap password. If empty, a random one is generated and printed ONCE
# on first start. The admin is forced to change it at first login.
KINGPIN_ADMIN_PASSWORD=
# Number of reverse proxies/tunnels in front of the app (0 = none, 1 = Cloudflare Tunnel / Tailscale Funnel).
# Needed so login rate limiting sees real visitor IPs. Never set >0 if the app is directly reachable from the internet.
KINGPIN_TRUST_PROXY=0
KINGPIN_PIN_MIN_LENGTH=6
KINGPIN_SESSION_IDLE_MINUTES=15
KINGPIN_SESSION_TAB_GRACE_SECONDS=180
KINGPIN_SESSION_MAX_HOURS=12
KINGPIN_LOGIN_MAX_FAILURES=5
KINGPIN_LOGIN_WINDOW_MINUTES=15
KINGPIN_LOGIN_LOCKOUT_MINUTES=15
